# ─────────────────────────────────────────────────────────────────────────────
# ClientPilotAI — Frontend environment
#
# Copy to .env for local development. For deployments, set these in the hosting
# provider's environment variables.
#
# ⚠️  Every VITE_* variable is compiled into the public JavaScript bundle and is
#     readable by anyone who loads the site. Never put a secret here — no
#     service_role key, no AI provider key, no email provider key. Those belong
#     in backend/.env only.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase (public values) ────────────────────────────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon/publishable key. Safe to expose: it is constrained by Row Level
# Security policies. Do not substitute the service_role key.
VITE_SUPABASE_ANON_KEY=your_anon_key

# ─── Backend API ─────────────────────────────────────────────────────────────
# Where the Express API lives.
#
#   Local development  → VITE_API_URL=http://localhost:3001
#   Production deploy  → VITE_API_URL=https://clientpilotai-1.onrender.com
#   Same-origin deploy → leave blank so requests go to /api on the same host.
#
VITE_API_URL=https://clientpilotai-1.onrender.com
