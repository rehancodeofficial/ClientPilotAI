PORT=3001
NODE_ENV=production
FRONTEND_URL=https://client-pilot-ai-psi.vercel.app

# Supabase Admin access (for database operations and token verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Gemini AI (Google AI Studio key starting with AIza)
GEMINI_API_KEY=AIzaSy...

# Optional OpenStreetMap / Overpass / Nominatim configuration
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=ClientPilotAI/1.0 (contact@clientpilotai.internal)
OSM_REQUEST_TIMEOUT_MS=30000
