# ─────────────────────────────────────────────────────────────────────────────
# ClientPilotAI — Backend environment
#
# Copy to backend/.env for local development. For deployments, set these in the
# hosting provider's environment variables instead; .env files are gitignored
# and are never uploaded.
#
# The server validates all of this at boot (see src/lib/env.ts). Anything marked
# REQUIRED aborts startup when missing or malformed. Anything marked OPTIONAL
# logs a warning and disables just the feature that needs it.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Supabase — REQUIRED ─────────────────────────────────────────────────────
# Supabase → Project Settings → API

# Project URL. No trailing slash, no path.
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role secret, NOT the anon key. It bypasses Row Level Security, so
# it must only ever exist server-side — never in any VITE_* variable, which are
# compiled into the public frontend bundle.
# Boot fails if the anon key is supplied here by mistake.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Project Settings → API → JWT Settings → JWT Secret.
# Used to issue and verify demo session tokens.
SUPABASE_JWT_SECRET=your_jwt_secret

# Anon key. Safe to expose; used only by scripts that exercise RLS as a client.
SUPABASE_ANON_KEY=your_anon_key

# ─── AI provider — OPTIONAL ──────────────────────────────────────────────────
# Powers lead scoring, opportunity analysis, outreach drafting and proposal
# generation. Without a key those endpoints return HTTP 503 (AI_NOT_CONFIGURED)
# rather than writing placeholder rows.
#
# The provider is chosen by whichever key is present, in this order:
#   AGENTROUTER_API_KEY  →  AgentRouter   (https://agentrouter.org/v1)
#   GEMINI_API_KEY       →  Google Gemini (OpenAI-compatible endpoint)
#   OPENAI_API_KEY       →  OpenAI        (https://api.openai.com/v1)
# Set exactly one unless you deliberately want AgentRouter to take precedence.
#
# Gemini is the configured provider. Get a key at:
#   https://aistudio.google.com/app/apikey
# Google AI Studio keys always start with "AIza".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative providers, if you switch away from Gemini.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AGENTROUTER_API_KEY=
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# AGENTROUTER_MODEL=gpt-4o-mini

# Run `npx ts-node src/scripts/check-ai.ts` to confirm which provider the
# backend will use and whether the key is accepted.

# ─── Email delivery (Resend) — REQUIRED for custom auth emails ───────────────
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Verified sender address on your verified custom domain (e.g. auth@yourdomain.com)
RESEND_FROM_EMAIL=ClientPilot AI <notifications@yourverifieddomain.com>
OUTREACH_FROM_EMAIL=outreach@yourverifieddomain.com

# Webhook secret for validating Resend delivery events (svix signature verification)
# Resend Dashboard -> Webhooks -> Add Webhook endpoint -> Signing Secret
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret

# Application public URL (production custom domain or http://localhost:5173)
APP_BASE_URL=https://clientpilotai.rehanhussain.dev

# ─── Demo sign-in — OPTIONAL, off by default ─────────────────────────────────
# POST /api/auth/demo issues an API token to anyone who calls it, with no
# credential. That is deliberate for a public demo, but it must be switched on
# explicitly. Leave unset in production unless you intend the demo workspace to
# be publicly reachable. Requires `npm --prefix backend run seed:demo` first.
ENABLE_DEMO_AUTH=false

# Demo account addresses, used by both the seed script and the demo endpoint.
# DEMO_ADMIN_EMAIL=demo-admin@clientpilot.test
# DEMO_USER_EMAIL=demo-user@clientpilot.test
# DEMO_ADMIN_PASSWORD=
# DEMO_USER_PASSWORD=

# ─── Frontend origin — OPTIONAL ──────────────────────────────────────────────
# Your deployed frontend URL, added to the CORS allowlist.
FRONTEND_URL=https://clientpilotai.rehanhussain.dev

# ─── OpenStreetMap — OPTIONAL (sensible defaults applied) ────────────────────
# Overridable endpoints for geocoding and business discovery. OSM asks that you
# identify your application in the User-Agent.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_USER_AGENT=ClientPilotAI/1.0 (contact@yourdomain.com)
# OSM_REQUEST_TIMEOUT_MS=30000
