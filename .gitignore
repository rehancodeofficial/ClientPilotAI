# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables — never commit real secrets.
# Tracked .env files leaked the service-role key to this public repo once already;
# note that these rules do NOT protect a file that is already tracked.
.env
.env.*
# ...but the documented templates must stay committable.
!.env.example
!**/.env.example
.vercel

# TypeScript incremental build cache
*.tsbuildinfo

# Consolidated migration paste, generated per-environment to resume a
# partially applied chain. The numbered migrations are the record.
supabase/_apply_missing.sql
